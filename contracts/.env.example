# Copy to .env and fill in. Never commit .env.
# Deployer wallet private key (use a fresh testnet-only wallet).
PRIVATE_KEY=
# Optional: your own BNB Smart Chain testnet RPC endpoint.
BSC_TESTNET_RPC_URL=
# Optional: BscScan API key for contract verification.
BSCSCAN_API_KEY=
# Address of the university oracle signer allowed to approve rewards.
ORACLE_ADDRESS=
